# ─── OmniVoice Studio — Environment Variables ──────────────────────────────────
# Copy to .env and fill in your values.

# HuggingFace
HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXX
HF_HOME=./hf_cache
# Prevent HF Hub from checking the internet on every run (models already cached)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
DEBUG=false

# Paths
OUTPUT_DIR=./omnivoice_outputs
DB_URL=sqlite+aiosqlite:///./omnivoice.db

# Redis (optional caching layer — leave blank to disable)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-before-prod-at-least-32-chars
API_KEY_ENABLED=false
API_KEY=your-api-key-here

# Model defaults
DEFAULT_QUANT=4bit
DEFAULT_DEVICE=cuda:0

# Rate limiting (requests per minute per IP)
RATE_LIMIT=20

# Metrics
METRICS_ENABLED=true
